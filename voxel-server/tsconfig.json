{
  "compilerOptions": {
    "outDir": "dist",
    "target": "es2016",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    
    // CRITICAL: Allow compiling files outside of ./src
    // This prevents "File '...' is not under 'rootDir'" errors when you include shared
    "rootDir": ".." 
  },
  "include": [
    "src",
    "../shared"  // 👈 THIS IS THE MISSING LINK
  ]
}